{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberrange",
  "main": "worker-entry.js",
  "compatibility_date": "2026-08-10",
  // Required for Cloudflare Workers Builds pull-request previews.
  "previews": {},
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "backup/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/health/*",
      "/compliance-lab",
      "/compliance-lab/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
